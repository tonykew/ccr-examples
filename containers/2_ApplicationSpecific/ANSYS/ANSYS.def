Bootstrap: docker
From: ubuntu:24.04

#
# There are three ways to install ANSYS
#
# 1) with CD images (.iso files)
# 2) with CD images (.iso files) and an ANSYS Service Pack Tarball
# 3) with the ANSYS installer script "AnsysInstaller.sh"
#
#  NOTE: optoin 3 will install the latest version of ANSYS
#
###############################################################################
# CD Image install
###############################################################################
#
# Build uses two variables, the common part of the install CD .iso filenames
# and a temporary directory into which all the CDs will be extracted - this
# will need ~100GB of free space.
#
# Both "INSTALL_CD_BASENAME" and "TMPDIR" must be defined
#
# For example:
#
#  apptainer build \
#   --build-arg TMPDIR="${SLURMTMPDIR}" \
#   --build-arg INSTALL_CD_BASENAME="ANSYS2026R1_LINX64_DISK" \
#   --bind "$(pwd)":"/tmp/installer_dir" \
#   ANSYS-x86_64.sif ANSYS.def
#
###############################################################################
# ANSYS Service Pack Tarball install
###############################################################################
#
# Note: this needs the Service Pack tarball AND the CD .iso files
#
# Build uses three variables, the "INSTALL_CD_BASENAME" as explained  above,
# the Service Pack tarball filename (the tarball must be in the current
# directory) and a temporary directory (as above) into which all the CDs will
# be extracted, (and subsequently, all the files in the tarball will be
# extracted after the CD files are removed) - this can need as much as ~100GB
# of free space.
#
# INSTALL_CD_BASENAME",  "SERVICE_PACK_TARBALL" and "TMPDIR" must be defined
# defined
#
# For example:
# 
#  apptainer build \
#   --build-arg INSTALL_CD_BASENAME="ANSYS2026R1_LINX64_DISK" \
#   --build-arg SERVICE_PACK_TARBALL="ANSYS_2026R1.04_LINX64.tgz" \
#   --build-arg TMPDIR="${SLURMTMPDIR}" \
#   --bind "$(pwd)":"/tmp/installer_dir" \
#   ANSYS-x86_64.sif ANSYS.def
#
###############################################################################
# ANSYS installer script "AnsysInstaller.sh" install
###############################################################################
#
# Build uses thre variables, the installer script filename (which must be in
# the current directory,) a valid AnsysID token (from https://id.ansys.com)
# and a temporary directory into which all the files the installer will
# download will be stored - this can need as much as ~100GB of free space.
#
# "INSTALL_SCRIPT". "ANSYSID_TOKEN" and "TMPDIR" must be defined
#
# For example:
#
#  apptainer build \
#   --build-arg INSTALL_SCRIPT="AnsysInstaller.sh" \
#   --build-arg ANSYSID_TOKEN="..." \
#   --build-arg TMPDIR="${SLURMTMPDIR}" \
#   --bind "$(pwd)":"/tmp/installer_dir" \
#   ANSYS-x86_64.sif ANSYS.def
#
###############################################################################
#
# NOTE: it is possible to hard code the license server information in the .sif
#  file, but this is ill-advised.
#  To do so, add the following build option(s):
#
#   --build-arg FLEXLM_LICENSING_SERVER="my.licensing.server"
#
#      ...and, if not using the default ports:
#
#   --build-arg ANSYS_LICENSING_PORT="2345"
#   --build-arg FLEXLM_LICENSING_PORT="3456"
#
#  Instead, leave the license server undefined; then, to run ANSYS progams,
#  create a license file e.g. 
#
#    $ cat ansyslmd.ini
#    SERVER=[port_number]@my.license.server.hostname
#    $
#
#    Or, for multiple license servers:
#
#    $ cat ansyslmd.ini
#    SERVER=[port_number]@my.license.server.hostname:[port_number]@my.second.license.server.hostname:[port_number]@my.third.license.server.hostname
#    $
#
#  and bind mount the file to /opt/ansys_inc/shared_files/licensing/ansyslmd.ini
#  for the Apptainer run e.g.
# 
#    $ apptainer run \
#     --bind "$(pwd)/ansyslmd.ini":"/opt/ansys_inc/shared_files/licensing/ansyslmd.ini":ro \
#     [...]
#   

%arguments
    TMPDIR=""
    INSTALL_CD_BASENAME=""
    SERVICE_PACK_TARBALL=""
    INSTALL_SCRIPT=""
    ANSYSID_TOKEN=""
    ANSYS_LICENSING_PORT="2325"
    FLEXLM_LICENSING_PORT="1055"
    FLEXLM_LICENSING_SERVER=""

%setup 
  # create mountpoint for /scratch during the build (for ${SLURMTMPDIR})
  mkdir "${APPTAINER_ROOTFS}/scratch"

%post -c /bin/bash
  # Set build install option variables passed with "--build-arg"
  export INSTALL_CD_BASENAME="{{ INSTALL_CD_BASENAME }}"
  export SERVICE_PACK_TARBALL="{{ SERVICE_PACK_TARBALL }}"
  export INSTALL_SCRIPT="{{ INSTALL_SCRIPT }}"
  export ANSYSID_TOKEN="{{ ANSYSID_TOKEN }}"

  cd_install=""
  service_pack_install=""
  installer_script_install=""
  install_opt_count=0

  if [ "${INSTALL_CD_BASENAME}" != "" ] && [ "${SERVICE_PACK_TARBALL}" = "" ] && [ "${INSTALL_SCRIPT}" = "" ]
  then
    cd_install="true"
    install_opt_count="$(expr ${install_opt_count} + 1 )"
  fi
  if [ "${INSTALL_CD_BASENAME}" != "" ] && [ "${SERVICE_PACK_TARBALL}" != "" ] && [ "${INSTALL_SCRIPT}" = "" ]
  then
    service_pack_install="true"
    install_opt_count="$(expr ${install_opt_count} + 1 )"
  fi
  if [ "${INSTALL_CD_BASENAME}" = "" ] && [ "${SERVICE_PACK_TARBALL}" = "" ] && [ "${INSTALL_SCRIPT}" != "" ]
  then
    installer_script_install="true"
    install_opt_count="$(expr ${install_opt_count} + 1 )"
  fi

  if [ ${install_opt_count} -ne 1 ]
  then
    echo "you must use one, and only one of:" >&2
    echo " --build-arg INSTALL_CD_BASENAME=\"[...]\" \\" >&2
    echo "" >&2
    echo " --build-arg INSTALL_CD_BASENAME=\"[...]\" \\" >&2
    echo " --build-arg SERVICE_PACK_TARBALL=\"tarball_name.tgz\" \\" >&2
    echo "" >&2
    echo " --build-arg INSTALL_SCRIPT=\"AnsysInstaller.sh\" \\" >&2
    echo " --build-arg ANSYSID_TOKEN=\"...\" \\" >&2
    exit 1
  fi

  # Report the install type
  echo "============================================================================="
  echo -n "Install type: "
  if [ "${cd_install}" = "true" ]
  then
    echo "CD image install"
  fi
  if [ "${service_pack_install}" = "true" ]
  then
    echo "Service Pack Installation"
  fi
  if [ "${installer_script_install}" = "true" ]
  then
    echo "Installer sctipt installation"
  fi
  echo "============================================================================="

  if [ "${cd_install}" = "true" ]
  then
    # Bail early if the install CDs are missing
    if ! ls /tmp/installer_dir/${INSTALL_CD_BASENAME}*.iso > /dev/null 2>&1
    then
      echo "The basename of the ANSYS CD .iso files must be passed to the build command" >&2
      ecoh "amd the .iso files must be in the current directory" >&2
      echo "e.g." >&2
      echo "" >&2
      echo "apptainer build \\" >&2
      echo " --build-arg INSTALL_CD_BASENAME=\"ANSYS2026R1_LINX64_DISK\" \\" >&2
      if [ "${service_pack_install}" = "true" ]
      then
        echo " --build-arg SERVICE_PACK_TARBALL=\"ANSYS_2026R1.04_LINX64.tgz\" \\">&2
      fi
      echo " --build-arg TMPDIR=\"\${SLURMTMPDIR}\" \\" >&2
      echo " --bind \"\$(pwd)\":\"/tmp/installer_dir\" \\" >&2
      echo " ANSYS-x86_64.sif ANSYS.def" >&2
      exit 1
    fi
  fi

  if [ "${service_pack_install}" = "true" ]
  then
    # Bail early if the Service Pack tarball is missing
    if [ ! -f "/tmp/installer_dir/${SERVICE_PACK_TARBALL}" ]
    then
      echo "You must pass the Service Pack tarball filename to the build command" >&2
      echo "and the file must be in the current directory." >&2
      echo "e.g."
      echo "apptainer build \\" >&2
      echo " --build-arg INSTALL_CD_BASENAME=\"ANSYS2026R1_LINX64_DISK\" \\" >&2
      echo " --build-arg SERVICE_PACK_TARBALL=\"ANSYS_2026R1.04_LINX64.tgz\" \\">&2
      echo " --build-arg TMPDIR=\"\${SLURMTMPDIR}\" \\">&2
      echo " --bind \"\$(pwd)\":\"/tmp/installer_dir\" \\" >&2
      echo " ANSYS-x86_64.sif ANSYS.def" >&2
      exit 1
    fi
  fi

  if [ "${installer_script_install}" = "true" ]
  then
    # Bail early if the install script is missing, or we don't have an AnsysID token
    if [ ! -f "/tmp/installer_dir/${INSTALL_SCRIPT}" ] || [ "${ANSYSID_TOKEN}" = "" ]
    then
      echo "You must pass the installer script filename and the ANSYSID_TOKEN to the the" >&2
      echo "build command" >&2
      echo "Also, the installer script must be in the current directory." >&2
      echo "e.g."
      echo "apptainer build \\" >&2
      echo " --build-arg INSTALL_SCRIPT=\"ANSYS_2026R1.04_LINX64.tgz\" \\">&2
      echo " --build-arg ANSYSID_TOKEN=\"...\" \\" >&2
      echo " --build-arg TMPDIR=\"\${SLURMTMPDIR}\" \\">&2
      echo " --bind \"\$(pwd)\":\"/tmp/installer_dir\" \\" >&2
      echo " ANSYS-x86_64.sif ANSYS.def" >&2
      exit 1
    fi
  fi

  # Make sure TMPDIR is set and that the intial tarball expansion directory exists
  export TMPDIR="{{ TMPDIR }}"
  if [ "${TMPDIR}" = "" ]
  then
    echo "The build variable TMPDIR must be set and passed to apptainer e.g." >&2
    echo "" >&2
    echo "apptainer build \\" >&2
    echo " --build-arg TMPDIR=\"\${SLURMTMPDIR}\" \\">&2
    if [ "${cd_install}" = "true" ]
    then
      echo " --build-arg INSTALL_CD_BASENAME=\"ANSYS2026R1_LINX64_DISK\" \\">&2
    fi
    if [ "${service_pack_install}" = "true" ]
    then
      echo " --build-arg INSTALL_CD_BASENAME=\"ANSYS2026R1_LINX64_DISK\" \\">&2
      echo " --build-arg SERVICE_PACK_TARBALL=\"ANSYS_2026R1.04_LINX64.tgz\" \\">&2
    fi
    if [ "${installer_script_install}" = "true" ]
    then
      echo " --build-arg INSTALL_SCRIPT=\"\$(pwd)/AnsysInstaller.sh\" \\">&2
    fi
    echo " --bind \"\$(pwd)\":\"/tmp/installer_dir\" \\" >&2
    echo " ANSYS-x86_64.sif ANSYS.def" >&2
    exit 1
  fi

  # Licensing settings
  ANSYS_LICENSING_PORT="{{ ANSYS_LICENSING_PORT }}"
  FLEXLM_LICENSING_PORT="{{ FLEXLM_LICENSING_PORT }}"
  FLEXLM_LICENSING_SERVER="{{ FLEXLM_LICENSING_SERVER }}"

  if [ "${FLEXLM_LICENSING_SERVER}" != "" ]
  then
    echo "ANSYS_LICENSING_PORT=\"${ANSYS_LICENSING_PORT}\""
    echo "FLEXLM_LICENSING_PORT=\"${FLEXLM_LICENSING_PORT}\""
    echo "FLEXLM_LICENSING_SERVER=\"${FLEXLM_LICENSING_SERVER}\""
  fi

  # Set the timezone, if unset
  test -h /etc/localtime || ln -fs /usr/share/zoneinfo/America/New_York /etc/localtime

  cp /etc/apt/sources.list /etc/apt/sources.list~
  sed -E -i 's/^# deb-src /deb-src /' /etc/apt/sources.list
  apt-get -y update

  # Install man & man pages - this section can be removed if not needed
  # NOTE: Do this before installing anything else so their man pages are installed
  sed -e '\|/usr/share/man|s|^#*|#|g' -i /etc/dpkg/dpkg.cfg.d/excludes
  DEBIAN_FRONTEND=noninteractive apt-get -y install apt-utils groff dialog man-db manpages manpages-posix manpages-dev
  rm -f /usr/bin/man
  dpkg-divert --quiet --remove --rename /usr/bin/man

  # O/S package updates:
  DEBIAN_FRONTEND=noninteractive apt-get -y upgrade

  DEBIAN_FRONTEND=noninteractive apt-get -y install \
   tzdata \
   locales \
   csh \
   tcsh \
   unzip \
   wget \
   gawk \
   build-essential \
   autoconf \
   automake \
   pkg-config \
   gfortran \
   python3 \
   python3-pip \
   python3-setuptools \
   python3-sphinx \
   python3-sphinx-rtd-theme \
   python-is-python3 \
   zstd \
   gnulib \
   libssl-dev \
   zlib1g-dev \
   libbz2-dev \
   libncurses-dev \
   liblzma-dev \
   liblz4-tool \
   libcurl4-gnutls-dev \
   libdeflate-dev \
   pax-utils \
   libmpfr-dev \
   libgmp3-dev \
   libmpc-dev \
   x11-apps \
   xdg-utils \
   libgtk-3-dev \
   libgtk-4-dev \
   libxrender1 \
   libxtst6 \
   libxi6 \
   libswt-gtk-4-java \
   libwebkit2gtk-4.1-0 \
   libwebkitgtk-6.0-4 \
   libatomic1 \
   libopengl0 \
   libcublas12 \
   ubuntu-desktop \
   libjpeg62 \
   libnsl2 \
   libxcb-xinerama0 \
   libxcb-cursor0 \
   libcudart12 \
   libnvidia-compute-610 \
   libglapi-amber \
   libhsa-runtime64-1 \
   libibmad5 \
   libibumad3 \
   libllvm19 \
   libmunge2 \
   libnccl2 \
   librccl1 \
   librdmacm1t64 \
   libtbb12 \
   libtirpc-dev \
   libucx0 \
   libxcb-xinput0 \
   libxm4 \
   ocl-icd-opencl-dev \
   xfonts-75dpi \
   xfonts-100dpi \
   libmotif-dev \
   xterm \
   libqt5gui5 \
   mesa-utils \
   tk-dev \
   7zip \
   patchelf \
   less \
   curl \
   jq \
   nano \
   vim \
   apt-file

  # NOTE: apt-file is generally not needed to run, but can be useful during development
  apt-file update

  # These steps are necessary to configure Perl and can cause issues with Python if omitted
  sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
  dpkg-reconfigure --frontend=noninteractive locales
  update-locale LANG=en_US.UTF-8

  export LANG=en_US.UTF-8

  # For vglrun & associated libraries, install the latest VirtualGL from github
  cd /root
  curl -OL https://github.com/VirtualGL/virtualgl/releases/download/3.1.5/virtualgl_3.1.5_amd64.deb
  dpkg -i virtualgl_3.1.5_amd64.deb
  rm virtualgl_3.1.5_amd64.deb

  # Make a  directory for ANSYS files used by the install process
  mkdir -p "${TMPDIR}/ANSYS"
  cd "${TMPDIR}/ANSYS"

  # If we are doing a CD install, or a Service Pack install, extract the CDs
  if [ "${cd_install}" = "true" ] || [ "${service_pack_install}" = "true" ]
  then
    for ISO in /tmp/installer_dir/${INSTALL_CD_BASENAME}*.iso
    do
      # Note: "-aos" == Skip extracting of existing files
      7z x -aos "${ISO}"
    done
  fi

  # If we are doing an installer script install, verify the install script
  if [ "${installer_script_install}" = "true" ]
  then
    bash "/tmp/installer_dir/${INSTALL_SCRIPT}" --check
    if [ "$?" != "0" ]
    then
      echo "Installer script \"${INSTALL_SCRIPT}\" corrupted - bailing" >&2
      exit 1
    fi
  fi

  # ANSYS License server settings (not reccomended)
  extra_args=""
  # If ${FLEXLM_LICENSING_SERVER} is set, add licenseing settings to the
  # install command
  if [ "${FLEXLM_LICENSING_SERVER}" != "" ]
  then
    extra_args="-licserverinfo ${ANSYS_LICENSING_PORT}:${FLEXLM_LICENSING_PORT}:${FLEXLM_LICENSING_SERVER}"
  fi

  # Install ANSYS
  if [ "${cd_install}" = "true" ] || [ "${service_pack_install}" = "true" ]
  then
    # If the tarball is in a subdirectory, (not expected) cd there
    cd "$(find . -type f -name 'INSTALL' -exec dirname {} \; | head -1)" ||:
    bash ./INSTALL ${extra_args} -silent
    if [ "$?" != "0" ]
    then
      echo "ANSYS CD .iso INSTALL FAILED!!! - Bailing" >&2
      exit 1
    fi
  fi
  # If we are doing a Service Pack install, cleanup the extraction
  # directory, then extract the tarball & run the service pack install
  if [ "${service_pack_install}" = "true" ]
  then
    cd ..
    rm -rf "${TMPDIR}/ANSYS"
    mkdir -p "${TMPDIR}/ANSYS"
    cd "${TMPDIR}/ANSYS"
    gzip -dc "/tmp/installer_dir/${SERVICE_PACK_TARBALL}" | tar xf -
    # If the tarball is in a subdirectory, (not expected) cd there
    cd "$(find . -type f -name 'INSTALL' -exec dirname {} \; | head -1)" ||:
    bash ./INSTALL ${extra_args} -silent
    if [ "$?" != "0" ]
    then
      echo "ANSYS SERVICE PACK INSTALL FAILED!!! - Bailing" >&2
      exit 1
    fi
  fi

  if [ "${installer_script_install}" = "true" ]
  then
    bash "/tmp/installer_dir/${INSTALL_SCRIPT}" \
     --noprogress \
     --nox11 \
     --nochown \
     --nodiskspace \
     --accept \
     --target "${TMPDIR}/ANSYS" \
     -- ${extra_args} -ANSYSID_TOKEN "${ANSYSID_TOKEN}" -silent
    if [ "$?" != "0" ]
    then
      echo "ANSYS INSTALLER SCRIPT INSTALL FAILED!!! - Bailing" >&2
      exit 1
    fi
  fi

  # These setting are likely ignored, since they are set at the host level,
  # not inside thew container; but for completeness, here are several
  # suggested settings from the install documentation:
  echo '* hard memlock unlimited' >> /etc/security/limits.conf
  echo '* soft memlock unlimited' >> /etc/security/limits.conf
  # Recommended semaphore values:
  #   kernel.sem=256 40000 32 32000
  # however, using CCR's higher values:
  echo '32000	1024000000	500	32000' >> /etc/sysctl.conf
  # Note - suggested:
  #  $ ulimit -s 1024000
  # however CCR already sets this to unlimited i.e.
  #  $ ulimit -s unlimited

  # Fix some library dependencies
  if [ -f "/usr/lib/libXm.so.4" ] && [ ! -f "/usr/lib/libXm.so.3" ]
  then
    ln -s "/usr/lib/libXm.so.4" "/usr/lib/libXm.so.3"
  fi
  if [ -f "/usr/lib64/libXm.so.4" ] && [ ! -f "/usr/lib64/libXm.so.3" ]
  then
    ln -s "/usr/lib64/libXm.so.4" "/usr/lib64/libXm.so.3"
  fi
  if [ -f "/usr/lib/$(arch)-linux-gnu/libXm.so.4" ] && [ ! -f "/usr/lib/$(arch)-linux-gnu/libXm.so.3" ]
  then
    ln -s "/usr/lib/$(arch)-linux-gnu/libXm.so.4" "/usr/lib/$(arch)-linux-gnu/libXm.so.3"
  fi

  # The install should create the "ansset.ini" file, but if you change the
  # install to only install specific packages, this doesn't always happen:
  revn="$(find /opt/ansys_inc/ -maxdepth 1 -name 'v[0-9]*' | sed -E 's/^.*\/v([0-9]+)$/\1/')"
  if [ ! -f "/opt/ansys_inc/v${revn}/ansys/bin/ansset.ini" ]
  then
    echo "creating \"/opt/ansys_inc/v${revn}/ansys/bin/ansset.ini\""
    cat > "/opt/ansys_inc/v${revn}/ansys/bin/ansset.ini" << EOF
#!/bin/bash
export revn="${revn}"
export export QR_PATH="v\${revn}"
EOF
    chmod 755 "/opt/ansys_inc/v${revn}/ansys/bin/ansset.ini"
  fi

  # icepak (at least from ANSYS 2026 R1) requires TK version 8.5.19, but Ubuntu
  # noble ships with 8.6
  # The icepak dir /opt/ansys_inc/v261/AnsysEM/icepak/lib/tk8.5.19
  # only includes a few .tcl files - installing TK version 8.5.19 into
  # this directory adds the missing base TK files.
  cd "${TMPDIR}"
  topicepakdir="$(find /opt/ansys_inc/ -maxdepth 1 -name 'v[0-9]*')/AnsysEM/icepak"
  if [ -d "${topicepakdir}/lib/tcl8.5.19/lib" ] && \
     [ -d "${topicepakdir}/lib/tk8.5.19" ] && \
     [ ! -f "${topicepakdir}/lib/tk8.5.19/button.tcl" ] && \
     [ ! -f "/usr/share/tcltk/tk8.5/button.tcl" ]
  then
    # Download & configure TCL version 8.5.19, but don't install (already
    # installed in /opt/ansys_inc/v261/AnsysEM/icepak/lib/tcl8.5.19 but we
    # need some include files and a tclConfig.sh file with the correct paths
    # to build TK version 8.5.19
    curl -LO "http://prdownloads.sourceforge.net/tcl/tcl8.5.19-src.tar.gz"
    gzip -dc "tcl8.5.19-src.tar.gz" | tar xf -
    rm "tcl8.5.19-src.tar.gz"
    cd "tcl8.5.19/unix"
    ./configure \
     --prefix="${topicepakdir}/lib/tcl8.5.19" \
     --exec-prefix="${topicepakdir}/lib/tcl8.5.19"
    # copy the installed stub library here
    cp "${topicepakdir}/lib/tcl8.5.19/lib/libtclstub8.5.a" .
    cd "${TMPDIR}"
    # Install TK version 8.5.19 into the icepak dir
    # /opt/ansys_inc/v261/AnsysEM/icepak/lib/tcl8.5.19
    curl -LO "http://prdownloads.sourceforge.net/tcl/tk8.5.19-src.tar.gz"
    gzip -dc "tk8.5.19-src.tar.gz" | tar xf -
    rm "tk8.5.19-src.tar.gz"
    cd "tk8.5.19/unix"
    sed -i -e  '/^SCRIPT_INSTALL_DIR/s/$/.19/' \
     -e '/^DEMO_INSTALL_DIR/s|)/|).19/|' Makefile.in
    CFLAGS="-L${topicepakdir}/lib/tcl8.5.19/lib" \
     ./configure --with-tcl=../../tcl8.5.19/unix \
     --with-x \
     --prefix="${topicepakdir}" \
     --exec-prefix="${topicepakdir}" \
     --bindir="${topicepakdir}/bin.lnamd64" \
     --libdir="${topicepakdir}/lib/tk8.5.19/lib" \
     --mandir="${topicepakdir}/lib/tk8.5.19/man" \
     --includedir="${topicepakdir}/lib/tk8.5.19/include"
    make -j $(expr $(nproc) - 4)
    make install
    cd "${TMPDIR}"
    rm -rf "tcl8.5.19" "tk8.5.19"
  fi

%environment
  #
  # The SLURMTMPDIR environment variable is not available in this script, so
  # grab SLURMTMPDIR if it is in /proc/$$/environ
  grep -aq '\"SLURMTMPDIR=' /proc/$$/environ && export SLURMTMPDIR="$(grep -a '\"SLURMTMPDIR=' /proc/$$/environ | sed -E -e 's|^.*\"SLURMTMPDIR=||' -e 's|\".*$||' 
)"
  #
  # Make sure TMPDIR exists and is a directory
  uid="$(head -1 /proc/self/uid_map | awk '{print $2}')"
  export TMPDIR="${SLURMTMPDIR:-/var/tmp}/tmp_${uid}"
  mkdir -p "${TMPDIR}"
  #
  topbindir="$(find /opt/ansys_inc/ -maxdepth 1 -name 'v[0-9]*')"
  export PATH="${topbindir}/ansys/bin:${topbindir}/ansys/bin/linx64:${topbindir}/ACP:${topbindir}/autodyn/bin:${topbindir}/cfdpost:${topbindir}/CFX/bin:${topbindir}/fensapice/bin:${topbindir}/fluent/bin:${topbindir}/icemcfd/linux64_amd/bin:${topbindir}/AnsysEM/icepak/bin.lnamd64:${topbindir}/Motion/solver:${topbindir}/polyflow/bin:${topbindir}/TurboGrid/bin:${topbindir}/sherlock:${topbindir}/Framework/bin/Linux64:/opt/ansys_inc/v261/AnsysEM:/opt/ansys_inc/shared_files/licensing/lic_admin:$PATH"
  # Environment variables for icepak
  export ICEPAK_ROOT="${topbindir}/AnsysEM/icepak"
  # Environment variables for helic
  export HELIC_ROOT=/opt/ansys_inc/v261/AnsysEM/helic
  # Some MPI jobs fail without this:
  export LSTC_LICENSE="ansys"

%runscript
  #!/bin/bash
  export PS1="ANSYS$ "
  # Library path for "icepak"
  if echo "${1}" | grep -q "^icepak"
  then
    export LD_LIBRARY_PATH="$(find "$(find "/opt/ansys_inc/" -maxdepth 1 -name 'v[0-9]*')/AnsysEM/commonfiles/CPython/" -maxdepth 1 -name '[0-9]*')/linx64/Release/python/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
    export TCLLIBPATH="$(find /opt/ansys_inc/ -maxdepth 1 -name 'v[0-9]*')/icemcfd/linux64_amd/lib/bwidget"
  fi
  # Exec passed command (required for Modal ENTRYPOINT compatibility)
  exec "$@"

